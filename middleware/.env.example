# Copy this file to middleware/.env and fill in the values for your environment.
# middleware/.env is gitignored — never commit it with real keys.
#
# After running 'cdk deploy -c env=dev', retrieve the values from the CDK Outputs
# printed in the terminal (or from CloudFormation Outputs in the AWS Console).

# Google Maps API key — needed for address autocomplete on the trip ingestion form
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# API Gateway invoke URL — used only as a fallback; all prod calls go through CloudFront
# Format: https://<api-id>.execute-api.<region>.amazonaws.com/<stage>/
VITE_API_BASE_URL=https://YOUR_API_GATEWAY_ID.execute-api.YOUR_REGION.amazonaws.com/prod/

# Cognito User Pool — from CDK Outputs: UserPoolId and UserPoolClientId
VITE_USER_POOL_ID=YOUR_REGION_XXXXXX
VITE_USER_POOL_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID

# AWS region where the stack is deployed
VITE_AWS_REGION=ap-south-1
